{
  "name": "population-split",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A geography game: draw one line to split a country's population 50/50, using real WorldPop gridded population data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-data": "tsx scripts/validate-data.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "@turf/turf": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "tsx": "^4.19.1",
    "jsdom": "^25.0.1"
  }
}
